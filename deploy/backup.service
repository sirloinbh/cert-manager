# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Cert Manager daily database dump (and S3 copy when configured)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/cert-manager
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/cert-manager/deploy/backup.sh /tmp/cert-backup.sh && exec /bin/bash /tmp/cert-backup.sh dump'
TimeoutStartSec=30min
Nice=10
