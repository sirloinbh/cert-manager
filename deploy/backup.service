# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=영어 공부 daily database dump (and S3 copy when configured)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/english-study
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/english-study/deploy/backup.sh /tmp/english-backup.sh && exec /bin/bash /tmp/english-backup.sh dump'
TimeoutStartSec=30min
Nice=10
