# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Cert Manager pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/cert-manager
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/cert-manager/deploy/autodeploy.sh /tmp/cert-autodeploy.sh && exec /bin/bash /tmp/cert-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
