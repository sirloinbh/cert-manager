# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=영어 공부 pull-based deployment of origin/main
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/english-study
# Copied first: the deploy checks out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/english-study/deploy/autodeploy.sh /tmp/english-autodeploy.sh && exec /bin/bash /tmp/english-autodeploy.sh'
TimeoutStartSec=45min
Nice=10
