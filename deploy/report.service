# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=영어 공부 daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/english-study
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/english-study/deploy/report.sh /tmp/english-report.sh && exec /bin/bash /tmp/english-report.sh'
TimeoutStartSec=5min
