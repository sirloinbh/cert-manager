# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Cert Manager daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/cert-manager
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/cert-manager/deploy/report.sh /tmp/cert-report.sh && exec /bin/bash /tmp/cert-report.sh'
TimeoutStartSec=5min
