# 중앙 관리 파일. 수정은 sirloinbh/project-standards의 templates/app/deploy/에서
[Unit]
Description=영어 공부 health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/english-study
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/english-study/deploy/notify.sh /tmp/english-notify.sh && exec /bin/bash /tmp/english-notify.sh health'
TimeoutStartSec=2min
