# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Cert Manager health check signal for healthchecks.io
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/cert-manager
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/cert-manager/deploy/notify.sh /tmp/cert-notify.sh && exec /bin/bash /tmp/cert-notify.sh health'
TimeoutStartSec=2min
