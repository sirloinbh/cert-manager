# Managed file. Edit it in sirloinbh/project-standards templates/app/deploy/
[Unit]
Description=Cert Manager weekly restore check of the newest database dump
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/cert-manager
ExecStart=/bin/bash -c 'cp /opt/cert-manager/deploy/backup.sh /tmp/cert-restore-check.sh && exec /bin/bash /tmp/cert-restore-check.sh verify'
TimeoutStartSec=30min
Nice=10
